Add two numbers.


// loop jab tak chlegne jab tak l1, l1, null na ho jaye or agar lsat me carry bach jati h to bhi loop chlega 
// fir sum me store krake ones digit to node me add kra denge tens digit ko carry me store kra denge.

class Solution {
    public ListNode addTwoNumbers(ListNode l1, ListNode l2) {
        ListNode dummy=new ListNode(-1);
        ListNode head=dummy;
        int carry=0;
        while(l1!=null || l2!=null || carry>0){
            int sum=carry;
            if(l1!=null){
                sum+=l1.val;
                l1=l1.next;
            }
            if(l2!=null){
                sum+=l2.val;
                l2=l2.next;
            }
            int digit=sum%10;
            carry=sum/10;
            head.next=new ListNode(digit);
            head=head.next;
        }
        return dummy.next;
    }
}
