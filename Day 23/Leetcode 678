Valid parenthesis string


class Solution {
    public boolean checkValidString(String s) {
        int min=0;
        int max=0;
        for(int i=0;i<s.length();i++){
            char ch=s.charAt(i);
            if(ch=='('){
                min++;
                max++;
            }
            else if(ch==')'){
                min--;
                max--;
            }
            else{
                min--;
                max++;
            }
            if(max<0){
                return false;
            }
            min=Math.max(0,min);  
            // (*) phele min, max 1,1 hoga fir  pe min=0, max=2 fir , fir ) aane pe min-1, or max=1 to usse avoid krne 
            // ke liye hi min hmesa 0 hi rakhege kyuki opening brackets kabhi -ve nhi ho skte.
        }
        return min==0;
    }
}
