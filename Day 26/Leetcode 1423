Maxumin points you can obtain from cards


// phele left side se window ka sum nikal lenge for right left side window ,ove krate jaege jisme window ke right side se remove krenge or , mtlb windhow ke left side move krenge to top right side vale add hote jaege.
// isse hme max sum vali windw mil jaege.

class Solution {
    public int maxScore(int[] nums, int k) {
        int sum=0;
        for(int i=0;i<k;i++){
            sum+=nums[i];
        }
        int right=nums.length-1;
        int maxSum=sum;
        for(int i=k-1;i>=0;i--){
            sum=sum-nums[i]+nums[right];
            right--;
            maxSum=Math.max(maxSum,sum);
        }
        return maxSum;
    }
}
